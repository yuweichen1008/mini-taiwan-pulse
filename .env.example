VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# FlightRadar24 Business API — optional, browser-side live aircraft feed
# Get token from: https://fr24api.flightradar24.com
# When set: app uses FR24 instead of OpenSky for ADS-B layer
# When unset: app falls back to OpenSky (free, no auth, 30s refresh)
# Note: FR24 must have CORS enabled for your token; contact FR24 support if browser calls fail
VITE_FR24_API_TOKEN=your_fr24_business_api_token_here

# GCS (upload scripts) — service account key file created in GCP Console
GCS_BUCKET=migu-gis-data-collector
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./gcs-key.json
